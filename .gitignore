# 依赖与构建产物
node_modules/
build/
.dart_tool/
.gradle/
*.iml
.gflutter-plugins-dependencies
# 敏感：TLS 私钥 / 设备凭据 / 本机配置
bridge/tls/
bridge/data/devices.json
bridge/config.json
app/android/local.properties
app/android/key.properties
*.keystore
*.pfx
*.pem

# 构建产物：体积大，不进版本库（交付走文件分发/下载站）
dist/*.apk
dist/patches/

# Python 工具的字节码缓存（tools/ 下是开发用脚本，不随 App 分发）
__pycache__/
*.pyc

# 大体积原生库（构建依赖，不进版本库）：ffmpeg 那一套 10 个 .so 由
# install/build-ffmpeg-android.sh 编好后手工放进构建目录，持久副本在
# /root/办公/__migr/03-build-deps/android-node/jnilibs（见 docs/BUILD-LINUX.md §5.2）。
# 这条是防呆：**别把 27 MB 的 .so 提交进仓库**。
app/android/app/src/main/jniLibs/

# ⚠️ 鸿蒙（AGC）签名材料：p12 私钥 / key / csr 一律**绝不入库**。
# `*.keystore` / `*.pfx` / `*.pem` 在上面已经排掉，但 .p12/.key/.csr 不在那三条里 ——
# 2026-10-30 出 0.81 前预演 `git add -A` 时抓到的（会直接把调试私钥推上公开仓库）。
# 需要重签时按 docs/HARMONYOS-ROUTE-A-DOWNGRADE.md 附录 B 重新出 CSR 申请。
signing-agc/

# 鸿蒙构建缓存与 IDE 产物（不是源码）
ohos/.hvigor*/
app/ohos/.hvigor*/
ohos/.idea/
app/ohos/.idea/

# 本机 UI 复核截图（随手拍的工作区产物，发布截图走 screenshots/ 与 docs/shots/）
ui-review/
release-assets-backup/


# 鸿蒙工程的本机 SDK 路径（等价于 Android 的 local.properties）
ohos/local.properties
app/ohos/local.properties
